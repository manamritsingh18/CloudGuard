# Copy to .env only to override defaults. No secrets required.
CLOUDGUARD_PORT=8080
# Lab replica probes; production targets have their own intervals in monitor/targets.yaml.
CHECK_INTERVAL_SECONDS=5
CHECK_TIMEOUT_SECONDS=2
RETENTION_DAYS=7
# Supabase publishable key (sb_publishable_...) sent to Supabase health endpoints. Empty uses
# the RoadWatch key in targets.yaml. The monitor refuses to start with a secret key.
SUPABASE_PUBLISHABLE_KEY=
